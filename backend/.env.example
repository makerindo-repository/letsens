APP_NAME="LetSens AIoT Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=letsens
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# CORS & Sanctum Stateful Domains
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,*"
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173"

# EMQX Public MQTT Broker
MQTT_HOST="broker.emqx.io"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Gemini AI API Key
GEMINI_API_KEY=""
